{
  "version": 8,
  "name": "Open Infrastructure Map - Power",
  "sources": {
    "power": {
      "type": "vector",
      "tiles": ["https://openinframap.org/map/power/{z}/{x}/{y}.pbf"],
      "minzoom": 0,
      "maxzoom": 17
    }
  },

  "layers": [

    {
      "id": "power_plant_fill",
      "type": "fill",
      "source": "power",
      "source-layer": "power_plant",
      "minzoom": 5,
      "paint": {
        "fill-color": "hsl(30, 20%, 35%)",
        "fill-opacity": 0.2
      }
    },

    {
      "id": "power_plant_outline",
      "type": "line",
      "source": "power",
      "source-layer": "power_plant",
      "minzoom": 8,
      "layout": { "line-join": "round" },
      "paint": {
        "line-color": "#1e1e1e",
        "line-opacity": 0.8,
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0, 20, 4]
      }
    },

    {
      "id": "power_solar_panel_area",
      "type": "fill",
      "source": "power",
      "source-layer": "power_generator_area",
      "filter": ["==", ["get", "source"], "solar"],
      "minzoom": 11,
      "paint": {
        "fill-color": "#726BA9",
        "fill-opacity": 0.6,
        "fill-outline-color": "#323232"
      }
    },

    {
      "id": "power_substation_fill",
      "type": "fill",
      "source": "power",
      "source-layer": "power_substation",
      "minzoom": 13,
      "paint": {
        "fill-opacity": 0.35,
        "fill-color": [
          "step", ["get", "voltage"],
          "#7A7A85", 10,
          "#6E97B8", 25,
          "#55B555", 52,
          "#B59F10", 132,
          "#B55D00", 220,
          "#C73030", 310,
          "#B54EB2", 550,
          "#00C1CF"
        ]
      }
    },

    {
      "id": "power_substation_outline",
      "type": "line",
      "source": "power",
      "source-layer": "power_substation",
      "minzoom": 13,
      "paint": {
        "line-color": "#1e1e1e",
        "line-opacity": 0.8,
        "line-width": ["interpolate", ["linear"], ["zoom"], 13, 0.5, 20, 4]
      }
    },

    {
      "id": "power_line_underground",
      "type": "line",
      "source": "power",
      "source-layer": "power_line",
      "filter": ["any",
        ["==", ["get", "location"], "underground"],
        ["==", ["get", "location"], "underwater"]
      ],
      "paint": {
        "line-dasharray": [3, 2],
        "line-color": [
          "step", ["get", "voltage"],
          "#7A7A85", 10,
          "#6E97B8", 25,
          "#55B555", 52,
          "#B59F10", 132,
          "#B55D00", 220,
          "#C73030", 310,
          "#B54EB2", 550,
          "#00C1CF"
        ],
        "line-width": ["step", ["get", "voltage"], 1, 52, 2, 132, 3, 220, 4, 310, 5],
        "line-opacity": 0.8
      }
    },

    {
      "id": "power_line",
      "type": "line",
      "source": "power",
      "source-layer": "power_line",
      "filter": ["all",
        ["!=", ["get", "location"], "underground"],
        ["!=", ["get", "location"], "underwater"]
      ],
      "paint": {
        "line-color": [
          "step", ["get", "voltage"],
          "#7A7A85", 10,
          "#6E97B8", 25,
          "#55B555", 52,
          "#B59F10", 132,
          "#B55D00", 220,
          "#C73030", 310,
          "#B54EB2", 550,
          "#00C1CF"
        ],
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          3, ["step", ["get", "voltage"], 0.5, 52, 1, 132, 1.5, 220, 2, 310, 2.5],
          12, ["step", ["get", "voltage"], 1, 52, 2, 132, 3, 220, 4, 310, 5]
        ],
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 2, 0.3, 6, 1]
      }
    },

    {
      "id": "power_substation_point",
      "type": "circle",
      "source": "power",
      "source-layer": "power_substation_point",
      "minzoom": 5,
      "paint": {
        "circle-color": [
          "step", ["get", "voltage"],
          "#7A7A85", 10,
          "#6E97B8", 25,
          "#55B555", 52,
          "#B59F10", 132,
          "#B55D00", 220,
          "#C73030", 310,
          "#B54EB2", 550,
          "#00C1CF"
        ],
        "circle-radius": [
          "interpolate", ["linear"], ["zoom"],
          5, ["step", ["get", "voltage"], 1, 100, 2, 300, 3],
          12, ["step", ["get", "voltage"], 2, 100, 4, 300, 6]
        ],
        "circle-stroke-color": "#333333",
        "circle-stroke-width": 0.5,
        "circle-opacity": ["interpolate", ["linear"], ["zoom"], 2, 0.3, 6, 1]
      }
    },

    {
      "id": "power_wind_turbine",
      "type": "circle",
      "source": "power",
      "source-layer": "power_generator",
      "filter": ["==", ["get", "source"], "wind"],
      "minzoom": 10,
      "paint": {
        "circle-radius": ["interpolate", ["linear"], ["zoom"], 10, 3, 17, 9],
        "circle-color": "#55B555",
        "circle-stroke-color": "#2a7a2a",
        "circle-stroke-width": 1
      }
    },

    {
      "id": "power_generator_solar_node",
      "type": "circle",
      "source": "power",
      "source-layer": "power_generator",
      "filter": ["==", ["get", "source"], "solar"],
      "minzoom": 13,
      "paint": {
        "circle-radius": ["interpolate", ["linear"], ["zoom"], 13, 3, 18, 8],
        "circle-color": "#726BA9",
        "circle-stroke-color": "#4a4a80",
        "circle-stroke-width": 1
      }
    },

    {
      "id": "power_generator_other",
      "type": "circle",
      "source": "power",
      "source-layer": "power_generator",
      "filter": ["all",
        ["!=", ["get", "source"], "wind"],
        ["!=", ["get", "source"], "solar"]
      ],
      "minzoom": 10,
      "paint": {
        "circle-color": [
          "match", ["get", "source"],
          "hydro", "#6E97B8",
          "nuclear", "#C73030",
          "gas", "#B55D00",
          "coal", "#7A7A85",
          "biomass", "#8B6914",
          "waste", "#666666",
          "battery", "#B54EB2",
          "#888888"
        ],
        "circle-radius": ["interpolate", ["linear"], ["zoom"], 10, 3, 16, 8],
        "circle-stroke-color": "#333333",
        "circle-stroke-width": 1
      }
    },

    {
      "id": "power_plant_point",
      "type": "circle",
      "source": "power",
      "source-layer": "power_plant_point",
      "minzoom": 5,
      "paint": {
        "circle-color": [
          "match", ["get", "source"],
          "wind", "#55B555",
          "solar", "#726BA9",
          "hydro", "#6E97B8",
          "nuclear", "#C73030",
          "gas", "#B55D00",
          "coal", "#7A7A85",
          "biomass", "#8B6914",
          "waste", "#666666",
          "battery", "#B54EB2",
          "hsl(30, 20%, 35%)"
        ],
        "circle-radius": ["interpolate", ["linear"], ["zoom"], 5, 3, 12, 10],
        "circle-stroke-color": "#333333",
        "circle-stroke-width": 0.5,
        "circle-opacity": ["interpolate", ["linear"], ["zoom"], 4, 0.4, 8, 1]
      }
    },

    {
      "id": "power_line_label",
      "type": "symbol",
      "source": "power",
      "source-layer": "power_line",
      "minzoom": 7,
      "layout": {
        "text-field": [
          "case",
          ["has", "voltage"],
          ["concat", ["to-string", ["get", "voltage"]], " kV"],
          ""
        ],
        "symbol-placement": "line",
        "symbol-spacing": 400,
        "text-size": ["interpolate", ["linear"], ["zoom"], 7, 9, 18, 13],
        "text-optional": true
      },
      "paint": {
        "text-color": "#111",
        "text-halo-color": "#fff",
        "text-halo-width": 2
      }
    },

    {
      "id": "power_substation_label",
      "type": "symbol",
      "source": "power",
      "source-layer": "power_substation_point",
      "minzoom": 8,
      "layout": {
        "text-field": [
          "concat",
          ["case", ["has", "name"], ["concat", ["get", "name"], "\n"], ""],
          ["case", ["has", "operator"], ["concat", ["get", "operator"], "\n"], ""],
          ["case", ["has", "voltage"], ["concat", ["to-string", ["get", "voltage"]], " kV"], ""]
        ]
      },
      "paint": {
        "text-color": "#111",
        "text-halo-color": "#fff",
        "text-halo-width": 2
      }
    },

    {
      "id": "power_wind_turbine_label",
      "type": "symbol",
      "source": "power",
      "source-layer": "power_generator",
      "filter": ["==", ["get", "source"], "wind"],
      "minzoom": 12,
      "layout": {
        "text-field": [
          "concat",
          ["case", ["has", "name"], ["concat", ["get", "name"], "\n"], ""],
          ["case", ["has", "operator"], ["concat", ["get", "operator"], "\n"], ""],
          ["case",
            ["has", "output"],
            ["concat",
              [
                "to-string",
                [
                  "floor",
                  ["*", ["to-number", ["get", "output"]], 100]
                ]
              ],
              " MW"
            ],
            ""
          ]
        ]
      },
      "paint": {
        "text-color": "#1a5c1a",
        "text-halo-color": "#fff",
        "text-halo-width": 2
      }
    },

    {
      "id": "power_solar_area_label",
      "type": "symbol",
      "source": "power",
      "source-layer": "power_generator_area",
      "filter": ["all",
        ["==", ["get", "source"], "solar"],
        ["any", ["has", "name"], ["has", "operator"]]
      ],
      "minzoom": 11,
      "layout": {
        "text-field": [
          "concat",
          ["case", ["has", "name"], ["concat", ["get", "name"], "\n"], ""],
          ["case", ["has", "operator"], ["concat", ["get", "operator"], "\n"], ""],
          ["case",
            ["has", "output"],
            ["concat",
              [
                "to-number",["get", "output"]
              ],
              " MW"
            ],
            ""
          ]
        ]
      },
      "paint": {
        "text-color": "#2e2060",
        "text-halo-color": "#fff",
        "text-halo-width": 2
      }
    },

    {
      "id": "power_plant_label",
      "type": "symbol",
      "source": "power",
      "source-layer": "power_plant_point",
      "minzoom": 6,
      "layout": {
        "text-field": [
          "concat",
          ["case", ["has", "name"], ["concat", ["get", "name"], "\n"], ""],
          ["case", ["has", "operator"], ["concat", ["get", "operator"], "\n"], ""],
          ["case", ["has", "source"], ["concat", ["get", "source"], "\n"], ""],
          ["case",
            ["has", "output"],
            ["concat",
              [
                "to-string",
                [
                  "floor",
                  ["*", ["to-number", ["get", "output"]], 100]
                ]
              ],
              " MW"
            ],
            ""
          ]
        ]
      },
      "paint": {
        "text-color": "#111",
        "text-halo-color": "#fff",
        "text-halo-width": 2
      }
    }

  ]
}
