{
  "version": 8,
  "name": "Open Infrastructure Map - Power (no round)",
  "sources": {
    "power": {
      "type": "vector",
      "tiles": ["https://openinframap.org/map/power/{z}/{x}/{y}.pbf"],
      "minzoom": 0,
      "maxzoom": 17
    }
  },
  "layers": [

    {
      "id": "power_line_label",
      "type": "symbol",
      "source": "power",
      "source-layer": "power_line",
      "minzoom": 7,
      "layout": {
        "symbol-placement": "line",
        "symbol-spacing": 600,
        "text-field": [
          "case",
          ["has", "voltage"],
          [
            "concat",
            ["to-string",
              ["/", ["to-number", ["get", "voltage"]], 1000]
            ],
            " kV"
          ],
          ""
        ],
        "text-size": ["interpolate", ["linear"], ["zoom"], 7, 9, 18, 13]
      },
      "paint": {
        "text-color": "#111",
        "text-halo-color": "#fff",
        "text-halo-width": 2
      }
    },

    {
      "id": "power_substation_label",
      "type": "symbol",
      "source": "power",
      "source-layer": "power_substation_point",
      "minzoom": 8,
      "layout": {
        "text-field": [
          "concat",

          ["case", ["has", "name"], ["concat", ["get", "name"], "\n"], ""],
          ["case", ["has", "operator"], ["concat", ["get", "operator"], "\n"], ""],
          ["case", ["has", "substation"], ["concat", ["get", "substation"], "\n"], ""],

          ["case",
            ["has", "voltage"],
            ["concat",
              ["to-string",
                ["/", ["to-number", ["get", "voltage"]], 1000]
              ],
              " kV"
            ],
            ""
          ]
        ],
        "text-size": ["interpolate", ["linear"], ["zoom"], 8, 10, 15, 13],
        "text-variable-anchor": ["top", "bottom", "left", "right"]
      },
      "paint": {
        "text-color": "#111",
        "text-halo-color": "#fff",
        "text-halo-width": 2
      }
    },

    {
      "id": "power_generator_label",
      "type": "symbol",
      "source": "power",
      "source-layer": "power_generator",
      "minzoom": 11,
      "layout": {
        "text-field": [
          "concat",

          ["case", ["has", "name"], ["concat", ["get", "name"], "\n"], ""],
          ["case", ["has", "operator"], ["concat", ["get", "operator"], "\n"], ""],
          ["case", ["has", "type"], ["concat", ["get", "type"], "\n"], ""],

          ["case",
            ["any", ["has", "output"], ["has", "capacity"]],
            ["concat",
              ["to-string",
                ["coalesce",
                  ["to-number", ["get", "output"]],
                  ["to-number", ["get", "capacity"]]
                ]
              ],
              " MW"
            ],
            ""
          ]
        ],
        "text-size": ["interpolate", ["linear"], ["zoom"], 11, 9, 17, 12],
        "text-variable-anchor": ["top", "bottom", "left", "right"]
      },
      "paint": {
        "text-color": "#1a5c1a",
        "text-halo-color": "#fff",
        "text-halo-width": 2
      }
    },

    {
      "id": "power_generator_area_label",
      "type": "symbol",
      "source": "power",
      "source-layer": "power_generator_area",
      "minzoom": 11,
      "layout": {
        "text-field": [
          "concat",

          ["case", ["has", "name"], ["concat", ["get", "name"], "\n"], ""],
          ["case", ["has", "operator"], ["concat", ["get", "operator"], "\n"], ""],
          ["case", ["has", "type"], ["concat", ["get", "type"], "\n"], ""],

          ["case",
            ["any", ["has", "output"], ["has", "capacity"]],
            ["concat",
              ["to-string",
                ["coalesce",
                  ["to-number", ["get", "output"]],
                  ["to-number", ["get", "capacity"]]
                ]
              ],
              " MW"
            ],
            ""
          ]
        ],
        "text-size": ["interpolate", ["linear"], ["zoom"], 11, 10, 17, 13],
        "text-variable-anchor": ["center"]
      },
      "paint": {
        "text-color": "#2e2060",
        "text-halo-color": "#fff",
        "text-halo-width": 2
      }
    }

  ]
}
