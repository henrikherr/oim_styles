{
  "version": 8,
  "name": "OIM Power (fixed full QGIS safe)",
  "sources": {
    "power": {
      "type": "vector",
      "tiles": ["https://openinframap.org/map/power/{z}/{x}/{y}.pbf"]
    }
  },
  "layers": [

    {
      "id": "power_line",
      "type": "line",
      "source": "power",
      "source-layer": "power_line",
      "paint": {
        "line-color": "#6E97B8",
        "line-width": 1.2,
        "line-opacity": 0.8
      }
    },

    {
      "id": "power_line_label",
      "type": "symbol",
      "source": "power",
      "source-layer": "power_line",
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "case",
          ["has", "voltage"],
          ["concat", ["get", "voltage"], " V"],
          ""
        ]
      }
    },

    {
      "id": "power_substation",
      "type": "circle",
      "source": "power",
      "source-layer": "power_substation_point",
      "paint": {
        "circle-radius": 4,
        "circle-color": "#C73030",
        "circle-stroke-color": "#333",
        "circle-stroke-width": 0.5
      }
    },

    {
      "id": "power_substation_label",
      "type": "symbol",
      "source": "power",
      "source-layer": "power_substation_point",
      "layout": {
        "text-field": [
          "concat",
          ["case", ["has", "name"], ["get", "name"], ""],
          ["case",
            ["has", "operator"],
            ["concat", "\n", ["get", "operator"]],
            ""
          ],
          ["case",
            ["has", "voltage"],
            ["concat", "\n", ["get", "voltage"], " V"],
            ""
          ]
        ]
      }
    },

    {
      "id": "power_generator",
      "type": "circle",
      "source": "power",
      "source-layer": "power_generator",
      "paint": {
        "circle-radius": 3,
        "circle-color": "#55B555",
        "circle-stroke-color": "#2a7a2a",
        "circle-stroke-width": 0.5
      }
    },

    {
      "id": "power_generator_label",
      "type": "symbol",
      "source": "power",
      "source-layer": "power_generator",
      "layout": {
        "text-field": [
          "concat",

          ["case", ["has", "name"], ["get", "name"], ""],

          ["case",
            ["has", "operator"],
            ["concat", "\n", ["get", "operator"]],
            ""
          ],

          ["case",
            ["has", "type"],
            ["concat", "\n", ["get", "type"]],
            ""
          ],

          ["case",
            ["has", "output"],
            ["concat", "\n", ["get", "output"], " MW"],
            ""
          ]
        ]
      }
    },

    {
      "id": "power_generator_area",
      "type": "fill",
      "source": "power",
      "source-layer": "power_generator_area",
      "paint": {
        "fill-color": "#726BA9",
        "fill-opacity": 0.4,
        "fill-outline-color": "#333"
      }
    },

    {
      "id": "power_generator_area_label",
      "type": "symbol",
      "source": "power",
      "source-layer": "power_generator_area",
      "layout": {
        "text-field": [
          "concat",

          ["case", ["has", "name"], ["get", "name"], ""],

          ["case",
            ["has", "operator"],
            ["concat", "\n", ["get", "operator"]],
            ""
          ],

          ["case",
            ["has", "type"],
            ["concat", "\n", ["get", "type"]],
            ""
          ],

          ["case",
            ["has", "output"],
            ["concat", "\n", ["get", "output"], " MW"],
            ""
          ]
        ]
      }
    }

  ]
}
